# Copy this file to .env and fill in your values.
# Never commit .env — it holds your payment credentials.
# The app reads these from the environment (see "Loading env vars" in README).

# --- security -------------------------------------------------------------
# Random string used to sign login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 when you serve the site over HTTPS (recommended in production)
COOKIE_SECURE=0

# --- Binance Pay ----------------------------------------------------------
# From Binance Merchant dashboard -> Developers -> API keys.
# Leave both empty to run the store in SANDBOX mode (no real money).
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=
BINANCE_PAY_CERT_SN=

# Currency Binance charges in. USDT keeps 1 USD = 1 USDT.
PAY_CURRENCY=USDT

# Public HTTPS address of this site — Binance needs it for the webhook
# and for sending buyers back after payment.
PUBLIC_BASE_URL=http://localhost:3000

# Allow the "simulate payment" button when Binance is not configured.
PAYMENTS_ALLOW_SANDBOX=1

# --- Direct crypto payments (BTC / LTC / USDT-TRC20) ----------------------
# No API key needed for Bitcoin, Litecoin or USDT on TRON.
# Ethereum + USDT-ERC20 checking uses Etherscan; get a free key at
# https://etherscan.io/apis and paste it here.
ETHERSCAN_API_KEY=

# --- Email delivery -------------------------------------------------------
# Codes are always printed in the admin dashboard and saved to the outbox.
# Fill these in to actually send the email (Gmail needs an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Kudsi Shop
SMTP_TLS=1
SMTP_SSL=0

# --- server ---------------------------------------------------------------
PORT=3000
FLASK_DEBUG=0
