# Copy to /home/<you>/kudsi-shop/.env on PythonAnywhere and fill in.
# Never commit this file.

SECRET_KEY=replace-with-openssl-rand-hex-32
COOKIE_SECURE=1
TRUST_PROXY=1
DISABLE_PAYMENT_WATCHER=1

PUBLIC_BASE_URL=https://YOURUSERNAME.pythonanywhere.com

# Free PythonAnywhere cannot reach Binance/CoinGecko. Keep auto-verification off
# and use manual payment approval, or set manual crypto rates in Admin -> Payments.
PAYMENTS_ALLOW_SANDBOX=0
